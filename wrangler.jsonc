// Cloudflare reads this file when it publishes the site from GitHub.
// "name" must match the Worker's name in the Cloudflare dashboard, or the build fails.
{
  "name": "pheasantcouch",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
